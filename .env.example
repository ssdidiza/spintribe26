# SpinTribe environment variables (placeholders only — real values live in Vercel).
# There is intentionally no .env.local in the repo; copy what you need locally.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Strava OAuth ---
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# --- Sessions / cron ---
SESSION_SECRET=generate-a-long-random-string
CRON_SECRET=generate-a-long-random-string

# --- App origin (used in email links) ---
NEXT_PUBLIC_APP_URL=https://your-domain.example

# --- PayFast ---
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_MODE=sandbox
PAYFAST_CHECKOUT_SECRET=generate-a-long-random-string

# --- Coaching notifications: email (Resend) ---
RESEND_API_KEY=re_xxx
RESEND_FROM=SpinTribe <bookings@your-domain.example>
LESSON_COACH_EMAIL=coach@your-domain.example
LESSON_COACH_NAME=SpinTribe Coaching
FOUNDER_STRAVA_ID=your-strava-athlete-id

# --- Coaching notifications: WhatsApp (Meta Cloud API) ---
# From Meta for Developers -> your app -> WhatsApp -> API Setup.
# Use a permanent System User token in production, not the 24h test token.
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# Graph API version (optional, default v25.0).
WHATSAPP_API_VERSION=v25.0
# "template" (default; required for business-initiated sends in production)
# or "text" (testing only — works within a 24h customer-service window).
WHATSAPP_SEND_MODE=template
# Names of the approved templates in WhatsApp Manager (defaults shown).
WHATSAPP_TEMPLATE_REMINDER_24H=lesson_reminder_24h
WHATSAPP_TEMPLATE_REMINDER_1H=lesson_reminder_1h
WHATSAPP_TEMPLATE_LANGUAGE=en
